[ResourceSnakeHead]
filename = resources/SnakeHead.dds
[ResourceSnake]
filename = resources/Snake.dds
[ResourceBackgroundUI]
filename = resources/backgroundDefault.dds
[ResourceApple]
filename = resources/Apple.dds

[ResourceNumber0]
filename = resources/numbers/num_0.dds
[ResourceNumber1]
filename = resources/numbers/num_1.dds
[ResourceNumber2]
filename = resources/numbers/num_2.dds
[ResourceNumber3]
filename = resources/numbers/num_3.dds
[ResourceNumber4]
filename = resources/numbers/num_4.dds
[ResourceNumber5]
filename = resources/numbers/num_5.dds
[ResourceNumber6]
filename = resources/numbers/num_6.dds
[ResourceNumber7]
filename = resources/numbers/num_7.dds
[ResourceNumber8]
filename = resources/numbers/num_8.dds
[ResourceNumber9]
filename = resources/numbers/num_9.dds

[KeyShowMode]
condition = $snake
key = F
type = hold
$show_mode = 1

[KeySnakeToggle]
key = VK_CTRL VK_ALT P
type = toggle
$snake = 1

[KeyEasyModeInstruction]
condition = $snake
key = I
type = cycle
$show_instruction = 0,1

[KeyEasyModeToggle]
condition = $snake && $go_x == 0 && $go_y == 0
key = L
type = cycle
$easy_mode = 0,1

[KeyMoveLeft]
condition = $snake && $easy_mode == 0
key = A
$go_x = -0.0075
$go_y = 0

[KeyMoveRight]
condition = $snake && $easy_mode == 0
key = D
$go_x = 0.0075
$go_y = 0

[KeyMoveUp]
condition = $snake && $easy_mode == 0
key = W
$go_y = -0.015
$go_x = 0

[KeyMoveDown]
condition = $snake && $easy_mode == 0
key = S
$go_y = 0.015
$go_x = 0

[KeyMoveLeftEasy]
condition = $snake && $go_x != 0.0075
key = A
$go_x = -0.0075
$go_y = 0

[KeyMoveRightEasy]
condition = $snake && $go_x != -0.0075
key = D
$go_x = 0.0075
$go_y = 0

[KeyMoveUpEasy]
condition = $snake && $go_y != 0.015
key = W
$go_y = -0.015
$go_x = 0

[KeyMoveDowEasy]
condition = $snake && $go_y != -0.015
key = S
$go_y = 0.015
$go_x = 0

[CustomShaderSliderMenu]
vs = ../../Shaders/UIElement.hlsl
ps = ../../Shaders/UIElement.hlsl
blend = ADD SRC_ALPHA INV_SRC_ALPHA
cull = none
topology = triangle_strip
o0 = set_viewport bb
Draw = 4,0

[CommandListBackdrop]
x87 = 1
y87 = 1
z87 = 0
w87 = 0
ps-t100 = ResourceBackgroundUI
run = CustomShaderSliderMenu

