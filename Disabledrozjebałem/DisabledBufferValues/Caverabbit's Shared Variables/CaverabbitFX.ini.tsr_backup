namespace = rabbitFX

[constants]
global $R = 0
global $G = 0
global $B = 0
global $colourShift = 0
global $brightness = 0
global $bloom = 0

global $TempX17
global $TempY17
global $TempZ17
global $TempW17
global $TempZ18
global $TempY18

[CustomShaderBodyNN]
run = CommandListPre
ps = ./Shaders/CaveRabbitRGBFX-NNBody.hlsl
run = CommandListPost

[CustomShaderDressNN]
run = CommandListPre
ps = ./Shaders/CaveRabbitRGBFX-NNDress.hlsl
run = CommandListPost

[CustomShaderBodyWN]
run = CommandListPre
ps = ./Shaders/CaveRabbitRGBFX-WNBody.hlsl
run = CommandListPost

[CustomShaderDressWN]
run = CommandListPre
ps = ./Shaders/CaveRabbitRGBFX-WNDress.hlsl
run = CommandListPost

[CustomShaderWeapon]
run = CommandListPre
ps = ./Shaders/CaveRabbitRGBFX-Weapon.hlsl
run = CommandListPost

[CommandListPre]
$TempX17 = x17
$TempY17 = y17
$TempZ17 = w17
$TempW17 = z17
$TempZ18 = z18
$TempY18 = y18
x17 = $R
y17 = $G
z17 = $B
w17 = $colourShift
z18 = $brightness
y18 = $bloom

[CommandListPost]
handling = skip
drawindexed = auto
x17 = $TempX17
y17 = $TempY17
z17 = $TempZ17
w17 = $TempW17
z17 = $TempZ18
y17 = $TempY18
$R = 0
$G = 0
$B = 0
$colourShift = 0
$brightness = 0
$bloom = 0

