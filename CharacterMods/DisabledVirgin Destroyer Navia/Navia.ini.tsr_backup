[CommandListSlider1]
local $v = $Key1

;DRAW CURSOR
w87 = $bar1_yo * $size_y + $off_y
z87 = $v*$size_x+$off_x-($bar*res_height/res_width)/2

if $slider_id == 1
    ps-t100 = ResourceSliderUIOn
else
    ps-t100 = ResourceSliderUI
endif

run = CustomShaderSliderMenu

;DRAW Navia
x87 = $icon_size*3.5
y87 = $icon_size*1.75*res_width/res_height
z87 = $off_x-$icon_size*2.4
w87 = $bar7_yo * $size_y + $off_y - ($icon_size*6/1.9)
ps-t100 = ResourceBackgroundUI
run = CustomShaderSliderMenu

; DRAW RGB Toggle
x87 = 200/res_width
y87 = 128/res_height
z87 = $off_x-(200/res_width)
w87 = $bar7_yo * $size_y + $off_y-0.0325
ps-t100 = ResourceRGBToggle
run = CustomShaderSliderMenu


[CommandListSlider2]
local $v = $Key2

w87 = $bar2_yo * $size_y + $off_y
z87 = $v*$size_x+$off_x-($bar*res_height/res_width)/2

if $slider_id == 2
    ps-t100 = ResourceSliderUIOn
else
    ps-t100 = ResourceSliderUI
endif

run = CustomShaderSliderMenu



