run = CommandListManageMod

if $Mod_Enabled
    ib = ResourceNaviaDressIB
    ps-t0 = ResourceNaviaDressNormalMap
    ps-t1 = ResourceLocalVirtualDress
    ps-t2 = ResourceNaviaDressLightMap
