; MARK: Key Toggles


[KeyToggleMenu]
condition = $activeForMenu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = >
type = toggle
$menu = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\m = 1


[KeyToggleClick]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = VK_LBUTTON
type = hold
$toggleClick = 1


[KeyClick]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = VK_RBUTTON
type = hold
$click = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\use_sliders = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\move_menu = 1


[KeyReset0]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1 && $RGB_Toggle == 0
key = 0
type = toggle
Resource\Virgin_Destroyer_Navia_Texture_Edit_Menu\Color = copy BackupColor
$wheel_x = -1
$wheel_y = -1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\h0 = -1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\r0 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\g0 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\b0 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\update_color = 1


[KeyReset1]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1 && $RGB_Toggle == 1
key = 0
type = toggle
Resource\Virgin_Destroyer_Navia_Texture_Edit_Menu\ColorHair = copy BackupColorHair
$wheel_x1 = -1
$wheel_y1 = -1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\h1 = -1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\r1 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\g1 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\b1 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\update_color = 1


[KeyReset2]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1 && $RGB_Toggle == 2
key = 0
type = toggle
Resource\Virgin_Destroyer_Navia_Texture_Edit_Menu\ColorEyes = copy BackupColorHair
$wheel_x2 = -1
$wheel_y2 = -1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\h2 = -1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\r2 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\g2 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\b2 = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\update_color = 1


[KeyResetBody]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = <
type = toggle
$Key1 = 0
$Key2 = 0
$Key3 = 0
$Key4 = 0
$Key5 = 0
$Key6 = 0
$Key7 = 0


[KeyStepsIncrease]
key = VK_RIGHT NO_CTRL
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1 && !$keysteps
type = hold
transition = 2000
transition_type = cosine
wrap = true
$keysteps=0.05


[KeyStepsDecrease]
key = VK_LEFT NO_CTRL
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1 && !$keysteps
type = hold
transition = 2000
transition_type = cosine
$keysteps=-0.05


[KeyStepsSelector]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1 && !$keysteps
key = VK_DOWN NO_CTRL
back = VK_UP
type = cycle
$selector = 0,1,2,3,4,5,6,7


[KeyHoldHover]
condition = $menu && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = VK_ALT VK_CTRL
type = hold
$hover = 1
$\Virgin_Destroyer_Navia_Texture_Edit_Menu\use_sliders = 1



