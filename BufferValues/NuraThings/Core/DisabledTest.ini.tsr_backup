x87 = $box_width
y87 = $box_height
z87 = $box_start_x + ($box_width * $current_column) + ($box_offset_x  * $current_column) 
w87 = $box_start_y + ($box_height * $current_row) + ( $box_offset_y * $current_row)

ps-t100 = ResourceBox
