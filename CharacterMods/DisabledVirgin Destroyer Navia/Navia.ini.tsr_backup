; Navia

; Constants -------------------------

[Constants]
global $active = 0
global $creditinfo = 0

global persist $variable0 = 1
global persist $variable1 = 1
global persist $variable2 = 1

global persist $wheel_x = -1
global persist $wheel_y = -1

global persist $wheel_x1 = -1
global persist $wheel_y1 = -1

global persist $wheel_x2 = -1
global persist $wheel_y2 = -1

global $UpdateAll = 1

global $RGB_Toggle = 0


[KeySwap1]
condition = $active == 1 && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = 8
type = cycle
$variable1 = 0,1


[KeySwap2]
condition = $active == 1 && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = 9
type = cycle
$variable2 = 0,1


[KeyRGBToggle]
condition = $\Virgin_Destroyer_Navia_Texture_Edit_Menu\m == 1 && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = 7
type = cycle
$RGB_Toggle = 0,1,2


[KeyRGBTypeToggle]
condition = $\Virgin_Destroyer_Navia_Texture_Edit_Menu\m == 1 && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = 6
type = cycle
$RGB_Slider_Type = 0,1,2
run = CommandListUpdateAll



[Present]
post $active = 0
run = CommandListCreditInfo

if $active
    if $UpdateAll
        run = CommandListTextureShader
    endif

    if $\Virgin_Destroyer_Navia_Texture_Edit_Menu\m
        run = CommandListTextureShader

        $\NuraThings\Print\Letters\offset_x = 0
        $\NuraThings\Print\Letters\offset_y = $off_y-0.06

        if $RGB_Toggle == 0
            $\NuraThings\Print\Letters\String9 = 293024
            $\NuraThings\Print\Letters\String10 = 291815
        else if $RGB_Toggle == 1
            $\NuraThings\Print\Letters\offset_x = 0.0365
            $\NuraThings\Print\Letters\String9 = 17
            $\NuraThings\Print\Letters\String10 = 271810
        else if $RGB_Toggle == 2
            $\NuraThings\Print\Letters\offset_x = 0.0365
            $\NuraThings\Print\Letters\String9 = 14
            $\NuraThings\Print\Letters\String10 = 281434
        endif

        pre run = CommandList\NuraThings\Print\Letters\Run
        run = CommandList\NuraThings\Print\Letters\Reset
    endif
endif

