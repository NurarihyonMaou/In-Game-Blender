[CommandListMenu]
local $v = 0

if $menu == 1

    run = CommandListBackdrop
    run = CommandListDrawBars
    run = CommandListDrawText

    ; MARK: Sliders Logic


    if cursor_y >= 0.55 && cursor_y <= 0.55+(128/res_height)

        if cursor_x >= $RGB_X_Offset/2-0.0125 && cursor_x <= $RGB_X_Offset/2-0.0125+(128/res_width) && $toggleClick
            if $variable1 == 1
                $variable1 = 0
            else
                $variable1 = 1
            endif
            $toggleClick = 0
        endif

        if cursor_x >= $RGB_X_Offset+0.1 && cursor_x <= $RGB_X_Offset+0.1+(128/res_width) && $toggleClick
            if $variable2 == 1
                $variable2 = 0
            else
                $variable2 = 1
            endif
            $toggleClick = 0
        endif

     endif


if (cursor_x >= $off_x-$icon_size*2.4 && cursor_x <= $off_x-$icon_size*2.4+($icon_size*3.5)) && (cursor_y >= $bar7_yo * $size_y + $off_y - ($icon_size*6/1.9) && cursor_y <= $bar7_yo * $size_y + $off_y - ($icon_size*6/1.9)+($icon_size*1.75*res_width/res_height)) && $toggleClick
    $RGB_Toggle = $RGB_Toggle+1
    if $RGB_Toggle == 3
        $RGB_Toggle = 0
    endif
    $toggleClick = 0
endif



if (cursor_x >= $off_x-(200/res_width) && cursor_x <= $off_x-(200/res_width)+(200/res_width)) && (cursor_y >= $bar7_yo * $size_y + $off_y-0.0325 && cursor_y <= $bar7_yo * $size_y + $off_y-0.0325+(128/res_height)) && $toggleClick
    $RGB_Slider_Type = $RGB_Slider_Type+1
    if $RGB_Slider_Type == 3
        $RGB_Slider_Type = 0
    endif
    $toggleClick = 0
endif

;&& cursor_x >= $\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x+0.0065 && cursor_x <= $\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x+(256/res_width)-0.012 && cursor_y >= 0.2075 && cursor_y <= 0.19+(256/res_height)-0.02
    if $RGB_Slider_Type == 2 && ($hover || $click)

        $\NuraThings\KeepWithinCircle\start_x = $\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x
        $\NuraThings\KeepWithinCircle\start_y = 0.19
        $\NuraThings\KeepWithinCircle\circle_size = 256

        run = CommandList\NuraThings\KeepWithinCircle\Run

        local $isCursorWithinCircle = $\NuraThings\KeepWithinCircle\Result

        if $isCursorWithinCircle

            if $RGB_Toggle == 0
                $wheel_x = ((cursor_x-$\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x)*res_width)//1
                $wheel_y = ((cursor_y-0.19)*res_height)//1

            else if $RGB_Toggle == 1
                $wheel_x1 = ((cursor_x-$\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x)*res_width)//1
                $wheel_y1 = ((cursor_y-0.19)*res_height)//1

            else
                $wheel_x2 = (((cursor_x-$\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x)*res_width))//1
                $wheel_y2 = ((cursor_y-0.19)*res_height)//1

            endif

        endif
    endif

    ;if $click && cursor_x > $off_x && cursor_x < $off_x + $size_x && cursor_y > $off_y-$size_y/20 && cursor_y < $off_y+$size_y/10
    ;    $off_x = cursor_x-$size_x/2
    ;    $off_y = cursor_y-$size_y/40
    ;    $RGB_X_Offset = cursor_x-$size_x
    ;    $\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x = $RGB_X_Offset
    ;endif

    if $\Virgin_Destroyer_Navia_Texture_Edit_Menu\move_menu && cursor_x > $\Virgin_Destroyer_Navia_Texture_Edit_Menu\box_x + 0.1 && cursor_x < $\Virgin_Destroyer_Navia_Texture_Edit_Menu\box_x + 0.13 && cursor_y > $\Virgin_Destroyer_Navia_Texture_Edit_Menu\box_y && cursor_y < $\Virgin_Destroyer_Navia_Texture_Edit_Menu\box_y+0.3
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\box_x = cursor_x-(0.13/2)-0.05
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\box_y = cursor_y-(0.3/2)
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\bar_x = cursor_x-(0.125)
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\bar_y = cursor_y-((0.3 * 0.95)/2)
    endif


    if $selector || cursor_x > $off_x && cursor_x < $off_x + $size_x

        if $selector == 1 || cursor_y > $bar1_yo * $size_y + $off_y && cursor_y < $bar1_yo * $size_y + $bar + $off_y

            $slider_id = 1
            $Key1 = $Key1 + $keysteps

            if $hover || $click
                $v = (cursor_x-$off_x)/$size_x
                $Key1 = $v
            endif

            $Key1 = $Key1 * ($Key1 >= 0.005 && $Key1 <= 0.995) + ($Key1 > 0.995)
        endif

        if $selector == 2 || cursor_y > $bar2_yo * $size_y + $off_y && cursor_y < $bar2_yo * $size_y + $bar + $off_y

            $slider_id = 2
            $Key2 = $Key2 + $keysteps

            if $hover || $click
                $v = (cursor_x-$off_x)/$size_x
                $Key2 = $v
            endif

            $Key2 = $Key2 * ($Key2 >= 0.005 && $Key2 <= 0.995) + ($Key2 > 0.995)
        endif

        if $selector == 3 || cursor_y > $bar3_yo * $size_y + $off_y && cursor_y < $bar3_yo * $size_y + $bar + $off_y

            $slider_id = 3
            $Key3 = $Key3 + $keysteps

            if $hover || $click
                $v = (cursor_x-$off_x)/$size_x
                $Key3 = $v
            endif

            $Key3 = $Key3 * ($Key3 >= 0.005 && $Key3 <= 0.995) + ($Key3 > 0.995)
        endif

        if $selector == 4 || cursor_y > $bar4_yo * $size_y + $off_y && cursor_y < $bar4_yo * $size_y + $bar + $off_y

            $slider_id = 4
            $Key4 = $Key4 + $keysteps

            if $hover || $click
                $v = (cursor_x-$off_x)/$size_x
                $Key4 = $v
            endif

            $Key4 = $Key4 * ($Key4 >= 0.005 && $Key4 <= 0.995) + ($Key4 > 0.995)
        endif

        if $selector == 5 || cursor_y > $bar5_yo * $size_y + $off_y && cursor_y < $bar5_yo * $size_y + $bar + $off_y

            $slider_id = 5
            $Key5 = $Key5 + $keysteps

            if $hover || $click
                $v = (cursor_x-$off_x)/$size_x
                $Key5 = $v
            endif

            $Key5 = $Key5 * ($Key5 >= 0.005 && $Key5 <= 0.995) + ($Key5 > 0.995)
        endif

        if $selector == 6 || cursor_y > $bar6_yo * $size_y + $off_y && cursor_y < $bar6_yo * $size_y + $bar + $off_y

            $slider_id = 6
            $Key6 = $Key6 + $keysteps

            if $hover || $click
                $v = (cursor_x-$off_x)/$size_x
                $Key6 = $v
            endif

            $Key6 = $Key6 * ($Key6 >= 0.005 && $Key6 <= 0.995) + ($Key6 > 0.995)
        endif

        if $selector == 7 || cursor_y > $bar7_yo * $size_y + $off_y && cursor_y < $bar7_yo * $size_y + $bar + $off_y

            $slider_id = 7
            $Key7 = $Key7 + $keysteps

            if $hover || $click
                $v = (cursor_x-$off_x)/$size_x
                $Key7 = $v
            endif

            $Key7 = $Key7 * ($Key7 >= 0.005 && $Key7 <= 0.995) + ($Key7 > 0.995)
        endif
    endif

    run = CommandListDrawCursors

    $slider_id = 0
endif
;###MENU CODE END



[Constants]
; Mod Manager
global $NuraManager_active = 0

global $mod_type_id = 34
global persist $mod_id = -1
global persist $mod_enabled

global $swapped_in = 1

global $IncludedInMaxCount = 0
global $Nura_Manager_First_Run = 1

global $Resources_Set = 0

global $once_per_frame = 1

global persist $id_slot = 0




[Present]
; Mod Manager
if $NuraManager_active > 0
    post $NuraManager_active = $NuraManager_active-1
endif

if $NuraManager_active == 0
    $swapped_in = 1
endif

post $once_per_frame = 1

[ResourceModPath]
type = Buffer
data = "F:\XXMI\Games\Genshin\GIMI\Mods\CharacterMods\Navia\Virgin Destroyer Navia\Navia.ini"

[ResourceModToggles]
type = Buffer
format = R8_UINT
filename = Toggles.txt

[ResourceModAuthor]
type = Buffer
data = "Created by Nurarihyon | Outfit Model and Textures made by [Insert Name Here] | Base Body by ZeroRuka"

[ResourceModName]
type = Buffer
data = "Virgin Destroyer Navia"

[CommandListManageMod]       
$NuraManager_active = 10

if $\NuraThings\ModManager\setID == 1
    if $mod_type_id == $\NuraThings\ModManager\ActiveTypeID

        if $mod_enabled
    
            if $id_slot == 0
                $\NuraThings\ModManager\ActiveID = $mod_id
    
            else if $id_slot == 1
                $\NuraThings\ModManager\ActiveID1 = $mod_id
    
            ;else if $id_slot == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
    ;
            ;else if $id_slot == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
    ;
            ;else if $id_slot == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
    ;
            ;else if $id_slot == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 0
            ;    $\NuraThings\ModManager\ActiveID = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 1
            ;    $\NuraThings\ModManager\ActiveID1 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
            endif
        endif
    endif
endif
   
if $swapped_in || $\NuraThings\ModManager\ResetIDs == 1

    $\NuraThings\ModManager\ModTypeID = $mod_type_id

    run = CustomShader\NuraThings\ModManager\HandleModelIDs

    if $mod_type_id == $\NuraThings\ModManager\ActiveTypeID

        if $mod_enabled

            if $id_slot == 0
                $\NuraThings\ModManager\ActiveID = $mod_id

            else if $id_slot == 1
                $\NuraThings\ModManager\ActiveID1 = $mod_id

            ;else if $id_slot == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
;
            ;else if $id_slot == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
;
            ;else if $id_slot == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
;
            ;else if $id_slot == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 0
            ;    $\NuraThings\ModManager\ActiveID = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 1
            ;    $\NuraThings\ModManager\ActiveID1 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
            endif

        ;else if $\NuraThings\ModManager\ModCount == 0
        ;    $\NuraThings\ModManager\ActiveID = 0
        ;    $\NuraThings\ModManager\ActiveID1 = 0
        ;    $\NuraThings\ModManager\ActiveID2 = 0
        ;    $\NuraThings\ModManager\ActiveID3 = 0
        ;    $\NuraThings\ModManager\ActiveID4 = 0
        ;    $\NuraThings\ModManager\ActiveID5 = 0
        endif


        if $\NuraThings\ModManager\Random_Mode == 1
            post $\NuraThings\ModManager\get_random_id_next_frame = 1
        endif

        if $Nura_Manager_First_Run
            if $\NuraThings\ModManager\Random_Mode == 2
                post $\NuraThings\ModManager\get_random_id_next_frame = 1
            endif
            post $Nura_Manager_First_Run = 0
        endif

    endif

    $swapped_in = 0
endif


if $mod_type_id == $\NuraThings\ModManager\ActiveTypeID

    if $once_per_frame  

        $\NuraThings\ModManager\AllModsActiveCount = $\NuraThings\ModManager\AllModsActiveCount+1

        $\NuraThings\ModManager\ModCount = $\NuraThings\ModManager\ModCount+1

        if $mod_id == -1 || $\NuraThings\ModManager\ResetIDs == 2
            $mod_id = $\NuraThings\ModManager\ModCount
        endif

        $once_per_frame = 0

        $\NuraThings\ModManager\ModID = $mod_id

        run = CustomShader\NuraThings\ModManager\HandleModIDs
    endif

    if $mod_id == $\NuraThings\ModManager\ActiveID || $mod_id == $\NuraThings\ModManager\ActiveID1 || $mod_id == $\NuraThings\ModManager\ActiveID2 || $mod_id == $\NuraThings\ModManager\ActiveID3 || $mod_id == $\NuraThings\ModManager\ActiveID2 || $mod_id == $\NuraThings\ModManager\ActiveID3 || $mod_id == $\NuraThings\ModManager\ActiveID4 || $mod_id == $\NuraThings\ModManager\ActiveID5
        $mod_enabled = 1

        if $mod_id == $\NuraThings\ModManager\ActiveID
            $id_slot = 0
        else if $mod_id == $\NuraThings\ModManager\ActiveID1
            $id_slot = 1
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID2
        ;    $id_slot = 2
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID3
        ;    $id_slot = 3
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID4
        ;    $id_slot = 4
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID5
        ;    $id_slot = 5
        endif


	Resource\NuraThings\ModManager\ModPath = ref ResourceModPath unless_null
	Resource\NuraThings\ModManager\ModToggles = ref ResourceModToggles unless_null
	Resource\NuraThings\ModManager\ModAuthor = ref ResourceModAuthor unless_null
	Resource\NuraThings\ModManager\ModName = ref ResourceModName unless_null

        
    else
        $mod_enabled = 0
        
    endif
endif


if $once_per_frame  
    $\NuraThings\ModManager\AllModsActiveCount = $\NuraThings\ModManager\AllModsActiveCount+1
    $once_per_frame = 0
endif



