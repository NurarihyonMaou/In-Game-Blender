global $is_hold = 0

global $numbers_color = 1

post $icon_size_x = (128/res_width)/2
post $icon_size_y = (128/res_height)/2

[Present]
;$\NuraThings\Print\Numbers\Number = $offset_x
;$\NuraThings\Print\Numbers\widthScale = 4
;run = CommandList\NuraThings\Print\Numbers\Run

;$\NuraThings\Print\Numbers\Number = $offset_y
;$\NuraThings\Print\Numbers\widthScale = 5
;run = CommandList\NuraThings\Print\Numbers\Run
;local $isRs = 2
;if ps-t100 === null
;	$isRs = 1
;else
;	$isRs = 0
;endif

;$\NuraThings\Print\Numbers\Number = $isRs
;$\NuraThings\Print\Numbers\widthScale = 6
;run = CommandList\NuraThings\Print\Numbers\Run

if ($slot_1_skill_timestamp > 0 || $slot_1_burst_timestamp > 0) || ($slot_2_skill_timestamp > 0 || $slot_2_burst_timestamp > 0) || ($slot_3_skill_timestamp > 0 || $slot_3_burst_timestamp > 0) || ($slot_4_skill_timestamp > 0 || $slot_4_burst_timestamp > 0)
    run = CommandListTimer
endif

if $connect_icons == 1
;if $slot_1_burst_icon_x == 0 && $slot_1_burst_icon_y == 0
        $slot_1_burst_icon_x = $slot_1_skill_icon_x+0.05
        $slot_1_burst_icon_y = $slot_1_skill_icon_y
;endif

;if $slot_2_burst_icon_x == 0 && $slot_2_burst_icon_y == 0
        $slot_2_burst_icon_x = $slot_2_skill_icon_x+0.05
        $slot_2_burst_icon_y = $slot_2_skill_icon_y
;endif

;if $slot_3_burst_icon_x == 0 && $slot_3_burst_icon_y == 0
        $slot_3_burst_icon_x = $slot_3_skill_icon_x+0.05
        $slot_3_burst_icon_y = $slot_3_skill_icon_y
;endif

;if $slot_4_burst_icon_x == 0 && $slot_4_burst_icon_y == 0
        $slot_4_burst_icon_x = $slot_4_skill_icon_x+0.05
        $slot_4_burst_icon_y = $slot_4_skill_icon_y
endif

if $holdingSkillButton == 0
    $active_unit_hold = 0
else if $holdingSkillButton >= 0.24 && $is_hold == 1
    $active_unit_hold = 1
    run = CommandListSetToSlot
    $is_hold = 0
endif

;E
[KeySkill]
condition = $active_unit_id >= 0 && $active_unit_skill_cd_left <= 2
key = no_modifiers R
key = XB_RIGHT_TRIGGER
type = hold
transition = 1000
transition_type = linear
$holdingSkillButton = 1
run = CommandListSetSkillTime

[KeySkill2]
condition = $active_unit_id >= 0 && $is_hold == 0
key = no_modifiers R
key = XB_RIGHT_TRIGGER
type = cycle
wrap = false
$is_hold = 0,1

[KeyBurst]
condition = $active_unit_id >= 0 && $active_unit_burst_cd_left <= 2
key = no_modifiers Q
key = XB_Y
type = hold
run = CommandListSetBurstTime

[KeyDrag]
condition = ($slot_1_skill_timestamp > 0 || $slot_1_burst_timestamp > 0) || ($slot_2_skill_timestamp > 0 || $slot_2_burst_timestamp > 0) || ($slot_3_skill_timestamp > 0 || $slot_3_burst_timestamp > 0) || ($slot_4_skill_timestamp > 0 || $slot_4_burst_timestamp > 0)
key = VK_RBUTTON
type = hold
$drag = 1

[KeyReset]
condition = ($slot_1_skill_timestamp > 0 || $slot_1_burst_timestamp > 0) || ($slot_2_skill_timestamp > 0 || $slot_2_burst_timestamp > 0) || ($slot_3_skill_timestamp > 0 || $slot_3_burst_timestamp > 0) || ($slot_4_skill_timestamp > 0 || $slot_4_burst_timestamp > 0)
key = ALT V
type = toggle
$slot_1_skill_icon_x = 0.79
$slot_1_skill_icon_y = 0.220

$slot_2_skill_icon_x = 0.79
$slot_2_skill_icon_y = 0.310

$slot_3_skill_icon_x = 0.79
$slot_3_skill_icon_y = 0.400

$slot_4_skill_icon_x = 0.79
$slot_4_skill_icon_y = 0.490


$slot_1_burst_icon_x = 0.96125
$slot_1_burst_icon_y = 0.220

$slot_2_burst_icon_x = 0.96125
$slot_2_burst_icon_y = 0.310

$slot_3_burst_icon_x = 0.96125
$slot_3_burst_icon_y = 0.400

$slot_4_burst_icon_x = 0.96125
$slot_4_burst_icon_y = 0.490

[KeyConnectIcons]
key = ALT I
type = toggle
$connect_icons = 1

[KeyResetPositions]
key = ALT X
type = hold
run = CommandListReset

; MARK: CommandLists

[CommandListSetCurrentCD]
if $active_unit_id == $slot_1_unit_id
     $active_unit_skill_cd_left = $slot_1_skill_cd_left
     $active_unit_burst_cd_left = $slot_1_burst_cd_left

else if $active_unit_id == $slot_2_unit_id
     $active_unit_skill_cd_left = $slot_2_skill_cd_left
     $active_unit_burst_cd_left = $slot_2_burst_cd_left

else if $active_unit_id == $slot_3_unit_id
     $active_unit_skill_cd_left = $slot_3_skill_cd_left
     $active_unit_burst_cd_left = $slot_3_burst_cd_left

else if $active_unit_id == $slot_4_unit_id
     $active_unit_skill_cd_left = $slot_4_skill_cd_left
     $active_unit_burst_cd_left = $slot_4_burst_cd_left
endif


[CommandListCalculateNumbers]
$number = $number//1
$num0 = -1
$num1 = -1

if $number >= 10 && $number < 100
    $num1 = $number%10
    $num0 = $number//10
    $number = $number//10
endif

if $number >= 1 && $number < 10
    $num0 = $number//1
endif

run = CommandListPrint



[CommandListPrint]
$size_x = (64/res_width)/1.5
$size_y = (64/res_height)/1.5

$offset_x = $offset_x+0.01
$offset_y = $offset_y+0.008
;*$heightScale

if $num1 == -1
    $offset_x = $offset_x+0.007
endif


; MARK: Black Numbers
if $numbers_color == 1

    if $num0 == 0
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber0
        run = CustomShaderSliderMenu
    endif

    if $num0 == 1
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber1
        run = CustomShaderSliderMenu
    endif

    if $num0 == 2
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber2
        run = CustomShaderSliderMenu
    endif

    if $num0 == 3
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber3
        run = CustomShaderSliderMenu
    endif

    if $num0 == 4
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber4
        run = CustomShaderSliderMenu
    endif

    if $num0 == 5
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber5
        run = CustomShaderSliderMenu
    endif

    if $num0 == 6
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber6
        run = CustomShaderSliderMenu
    endif

    if $num0 == 7
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber7
