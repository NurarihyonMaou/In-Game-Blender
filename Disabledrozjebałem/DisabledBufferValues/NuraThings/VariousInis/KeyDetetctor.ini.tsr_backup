namespace = NuraThings\KeyDetector

[Constants]
global $detect_keys
global $key_code
global $last_key_code


[Present]
if $detect_keys
    $\NuraThings\Print\Numbers\Number = $last_key_code
    $\NuraThings\Print\Numbers\widthScale = 1
    $\NuraThings\Print\Numbers\heightScale = 4
    run = CommandList\NuraThings\Print\Numbers\Run
endif


[KeyEnable]
condition = !$detect_keys
key = VK_CONTROL VK_SHIFT VK_ALT
$detect_keys = 1

[KeyShift]
condition = $detect_keys
key = VK_SHIFT
$key_code = 1

