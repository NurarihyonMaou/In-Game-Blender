        $score = $score+1
        
        if !$easy_mode
            if $score > $best_score
                $best_score = $score
            endif
        else
            if $score > $best_score_easy_mode
                $best_score_easy_mode = $score
            endif
        endif
        
        $apple_ate = 1
        run = CommandListGenerateApple
    endif


