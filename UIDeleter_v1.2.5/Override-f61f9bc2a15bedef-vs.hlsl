// Main UI vertex shader for Genshrek Impact [f61f9bc2a15bedef-vs]
// Manually translated from asm to hlsl by Unicornshell Monday June 9th 2025

cbuffer CB0 : register(b0) {
  float4 cb0[15];
};

cbuffer CB1 : register(b1) {
  float4 cb1[4];
};

cbuffer CB2 : register(b2) {
  float4 cb2[21];
};

// Inputs
struct VS_Input {
  float4 position : POSITION;
  float4 color    : COLOR0;
  float2 texcoord : TEXCOORD0;
};

// Outputs
struct VS_Output {
  float4 svpos    : SV_POSITION;
  float4 color    : COLOR0;
  float2 texcoord : TEXCOORD0;
  float4 worldpos : TEXCOORD1;
};

SamplerState Sampler : register(s0);
Texture2D<float> DepthBuffer : register(t1);

// 3DMigoto declaration
Texture1D<float4> IniParams : register(t120);
// UI Library declaration
Buffer<float2> UIParams : register(t0);



VS_Output main(VS_Input input)
{
  VS_Output output;
	float2 scale = all(UIParams[0] != float2(0, 0)) ? UIParams[0] : float2(1, 1);
	float2 padding = UIParams[1];
    

  // transform to worldpos with cb1
  float4 r0 = input.position.y * cb1[1];
  r0 = cb1[0] * input.position.x + r0;
  r0 = cb1[2] * input.position.z + r0;
  r0 = r0 + cb1[3];
  
  // projection matrix from cb2
  float4 r1 = r0.y * cb2[18];
  r1 = cb2[17] * r0.x + r1;
  r1 = cb2[19] * r0.z + r1;
  output.svpos = cb2[20] * r0.w + r1;
  
  // linear color conversion (applying gamma?)
  float4 color = input.color * cb0[14];
  color.xyz = max(color.xyz, float3(0.0, 0.0, 0.0));
  output.color.w = color.w;
  
  color.xyz = log(color.xyz);
  color.xyz *= 1.0 / 2.4;  // approx 0.416666657, seems to work fine
  color.xyz = exp(color.xyz);
  color.xyz = color.xyz * 1.055 - 0.055;
  output.color.xyz = max(color.xyz, float3(0.0, 0.0, 0.0));
  
  // no change for original texcoord/position (worldpos)
  output.texcoord = input.texcoord;
  output.worldpos = input.position;
  
  


  
  // clip space to texture space [-1, 1] to [0,1]
	float2 uv = output.svpos.xy / output.svpos.w * 0.5 + 0.5;
  // sample depth texture at vertex location
	float depth = DepthBuffer.SampleLevel(Sampler, uv, 0);
  
  // somewhat functional depth check. I am a wizard
	if (!depth) {
  
	  /* (uint)IniParams[0].x
      0b000 -> Nothing
      0b001 -> Namecard
      0b010 -> Profile Menu
      0b100 -> Miliastra Background
    */
	  uint flags = (uint)IniParams[0].x;
    
    
    //capture Pause-Menu UID with position thresholds
	  if ((flags & 1) && (output.svpos.x < (-1 + padding.x + 0.28 * scale.x) && output.svpos.y > (1 - padding.y - 0.39 * scale.y) && output.svpos.y < (1 - padding.y - 0.34 * scale.y))) {
	  	output.color.w = 0;
	  }
    
    //capture Profile-Menu UID too
	  if ((flags & 2) && (output.svpos.x > (-0.4 * scale.x) && output.svpos.x < (-0.22 * scale.x) && output.svpos.y > (0.57 * scale.y) && output.svpos.y < (0.64 * scale.y))) {
	  	output.color.w = 0;
	  }
    
    // Miliastra Wonderland your profile + centered (others) profile                                                                                                                                                                                                                             because of the menu animation moving stuff around, we use larger size and check color
	  if ((flags & 4) && ((output.svpos.x > (-0.56 * scale.x) && output.svpos.x < (-0.38 * scale.x) && output.svpos.y > (0.51 * scale.y) && output.svpos.y < (0.555 * scale.y)) || (output.svpos.x > (-0.2 * scale.x) && output.svpos.x < (0.2 * scale.x) && output.svpos.y > (0.45 * scale.y) && output.svpos.y < (0.6 * scale.y) && output.color.x > 0.6))) {
	  	output.color.w = 0;
	  }
		float ythresh = scale.y * -0.0144355 - 1;
    // Corner UID
    // NGL I genuinely don't know how my threshold actually works I kinda forgot. But uhhhhhhh it works!
		if (output.svpos.x > (0.42) && output.svpos.y < ythresh + 0.069) {
	  	output.color.w = 0;
	  }
    
	}
  
	return output;
}

