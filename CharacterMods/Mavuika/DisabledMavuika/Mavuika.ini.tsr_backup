; Mavuika

; Constants -------------------------

[Constants]
global $active = 0
global $creditinfo = 0
global persist $NavelPiercing = 1


[KeySwapPiercing]
condition = $active == 1 && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = NO_MODIFIERS ]
back = Alt ]
type = cycle
$NavelPiercing = 1,0


[Present]
post $active = 0
run = CommandListCreditInfo

; Overrides -------------------------


[TextureOverrideMavuikaPosition]
hash = 80b13a2f
match_priority = 0
if $Mod_Enabled
    vb0 = ResourceMavuikaPosition
    $active = 1
    
endif

[TextureOverrideMavuikaBlend]
hash = 00088f8d
match_priority = 0
if $Mod_Enabled
    vb1 = ResourceMavuikaBlend
    handling = skip
    draw = 48077,0
    
endif

[TextureOverrideMavuikaTexcoord]
hash = 3af262c1
match_priority = 0
if $Mod_Enabled
    vb1 = ResourceMavuikaTexcoord
    
endif

[TextureOverrideMavuikaVertexLimitRaise]
hash = 00323c91
match_priority = 0
if $Mod_Enabled
    ; override_vertex_count = 39818
    ; override_byte_stride = 84
    
endif

[TextureOverrideMavuikaIB]
hash = 43f8af29
match_priority = 0
run = CommandListManageMod

if $Mod_Enabled
    handling = skip
    
endif

[TextureOverrideMavuikaHead]
hash = 43f8af29
match_first_index = 0
run = CommandListManageMod

if $Mod_Enabled
    ib = ResourceMavuikaHeadIB
    ;	ps-t0 = this is Shadow Map
    ;	ps-t1 = this is Diffuse Map
    ;	ps-t2 = this is Light Map
    ps-t0 = ResourceMavuikaDressShadow
    ps-t1 = ResourceMavuikaHeadDiffuse
    ps-t2 = ResourceMavuikaHeadLightMap
    run = CommandList\global\ORFix\ORFix
    ; Head 1 1
    ; HEAD (200)
    drawindexed = 576, 0, 0
    ; HEAD_Arms (2600)
    drawindexed = 10656, 576, 0
    ; HEAD_Cloth (2222)
    drawindexed = 4692, 11232, 0
    
    If $NavelPiercing == 1
        ; NavelPiercing (290)
        drawindexed = 642, 15924, 0
    endif
    
endif

[TextureOverrideMavuikaBody]
hash = 43f8af29
match_first_index = 16914
run = CommandListManageMod

if $Mod_Enabled
    ib = ResourceMavuikaBodyIB
    ;	ps-t0 = this is Shadow Map
    ;	ps-t1 = this is Diffuse Map
    ;	ps-t2 = this is Light Map
    ps-t0 = ResourceMavuikaNudeBodyShadow
    ps-t1 = ResourceMavuikaNudeBodyDiffuse
    ps-t2 = ResourceMavuikaNudeBodyLightMap
    run = CommandList\global\ORFix\ORFix
    
    ; Body 2
    ; Body_Torso_S (6087)
    drawindexed = 34620, 0, 0
    
    
endif

[TextureOverrideMavuikaDress]
hash = 43f8af29
match_first_index = 42618
run = CommandListManageMod

if $Mod_Enabled
    ib = ResourceMavuikaDressIB
    ;	ps-t0 = this is Shadow Map
    ;	ps-t1 = this is Diffuse Map
    ;	ps-t2 = this is Light Map
    ps-t0 = ResourceMavuikaDressShadow
    ps-t1 = ResourceMavuikaDressDiffuse
    ps-t2 = ResourceMavuikaDressLightMap
    run = CommandList\global\ORFix\ORFix
    
    ; DRESS_MeshToggle
    drawindexed = 41829, 0, 0
    
    ; CommandList -----------------------
    
endif

[CommandListCreditInfo]
if $creditinfo == 0 && $active == 1
    pre Resource\ShaderFixes\help.ini\Notification = ResourceCreditInfo
    pre run = CustomShader\ShaderFixes\help.ini\FormatText
    pre $\ShaderFixes\help.ini\notification_timeout = time + 5.0
    $creditinfo = 1
endif

; Resources -------------------------


[ResourceMavuikaPosition]
type = Buffer
stride = 40
filename = MavuikaPosition.buf


[ResourceMavuikaBlend]
type = Buffer
stride = 32
filename = MavuikaBlend.buf


[ResourceMavuikaTexcoord]
type = Buffer
stride = 12
filename = MavuikaTexcoord.buf


[ResourceMavuikaHeadIB]
type = Buffer
format = DXGI_FORMAT_R32_UINT
filename = MavuikaHead.ib


[ResourceMavuikaBodyIB]
type = Buffer
format = DXGI_FORMAT_R32_UINT
filename = MavuikaBody.ib


[ResourceMavuikaDressIB]
type = Buffer
format = DXGI_FORMAT_R32_UINT
filename = MavuikaDress.ib


[ResourceMavuikaHeadDiffuse]
filename = MavuikaHeadDiffuse.dds


[ResourceMavuikaHeadLightMap]
filename = MavuikaHeadLightMap.dds


[ResourceMavuikaDressDiffuse]
filename = MavuikaDressDiffuse.dds


[ResourceMavuikaDressLightMap]
filename = MavuikaDressLightMap.dds


[ResourceMavuikaDressShadow]
filename = MavuikaDressShadow.dds


[ResourceMavuikaNudeBodyDiffuse]
filename = MavuikaNudeBodyDiffuse.dds


[ResourceMavuikaNudeBodyLightMap]
filename = MavuikaNudeBodyLightMap.dds


[ResourceMavuikaNudeBodyShadow]
filename = MavuikaNudeBodyShadow.dds


[ResourceCreditInfo]
type = Buffer
data = "Created by KiberSkyDen"

; .ini generated by XXMI (XX-Model-Importer)
; If you have any issues or find any bugs, please open a ticket at https://github.com/leotorrez/XXMI-Tools/issues



[Constants]
; Mod Manager
global $NuraManager_active = 0

global $mod_type_id = 30
global persist $mod_id = -1
global persist $mod_enabled

global $swapped_in = 1

global $IncludedInMaxCount = 0
global $Nura_Manager_First_Run = 1

global $Resources_Set = 0

global $once_per_frame = 1

global persist $id_slot = 0




[Present]
; Mod Manager
if $NuraManager_active > 0
    post $NuraManager_active = $NuraManager_active-1
endif

if $NuraManager_active == 0
    $swapped_in = 1
endif

post $once_per_frame = 1

[ResourceModPath]
type = Buffer
data = "F:\XXMI\Games\Genshin\GIMI\Mods\CharacterMods\Mavuika\Mavuika\Mavuika.ini"

[ResourceModToggles]
type = Buffer
format = R8_UINT
filename = Toggles.txt

[ResourceModAuthor]
type = Buffer
data = "Created by KiberSkyDen"

[ResourceModName]
type = Buffer
data = "Mavuika"

[CommandListManageMod]       
$NuraManager_active = 10

if $\NuraThings\ModManager\setID == 1
    if $mod_type_id == $\NuraThings\ModManager\ActiveTypeID

        if $mod_enabled
    
            if $id_slot == 0
                $\NuraThings\ModManager\ActiveID = $mod_id
    
            else if $id_slot == 1
                $\NuraThings\ModManager\ActiveID1 = $mod_id
    
            ;else if $id_slot == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
    ;
            ;else if $id_slot == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
    ;
            ;else if $id_slot == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
    ;
            ;else if $id_slot == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 0
            ;    $\NuraThings\ModManager\ActiveID = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 1
            ;    $\NuraThings\ModManager\ActiveID1 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
    ;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
            endif
        endif
    endif
endif
   
if $swapped_in || $\NuraThings\ModManager\ResetIDs == 1

    $\NuraThings\ModManager\ModTypeID = $mod_type_id

    run = CustomShader\NuraThings\ModManager\HandleModelIDs

    if $mod_type_id == $\NuraThings\ModManager\ActiveTypeID

        if $mod_enabled

            if $id_slot == 0
                $\NuraThings\ModManager\ActiveID = $mod_id

            else if $id_slot == 1
                $\NuraThings\ModManager\ActiveID1 = $mod_id

            ;else if $id_slot == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
;
            ;else if $id_slot == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
;
            ;else if $id_slot == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
;
            ;else if $id_slot == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 0
            ;    $\NuraThings\ModManager\ActiveID = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 1
            ;    $\NuraThings\ModManager\ActiveID1 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 2
            ;    $\NuraThings\ModManager\ActiveID2 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 3
            ;    $\NuraThings\ModManager\ActiveID3 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 4
            ;    $\NuraThings\ModManager\ActiveID4 = $mod_id
;
            ;else if $\NuraThings\ModManager\ChooseActiveID == 5
            ;    $\NuraThings\ModManager\ActiveID5 = $mod_id
            endif

        ;else if $\NuraThings\ModManager\ModCount == 0
        ;    $\NuraThings\ModManager\ActiveID = 0
        ;    $\NuraThings\ModManager\ActiveID1 = 0
        ;    $\NuraThings\ModManager\ActiveID2 = 0
        ;    $\NuraThings\ModManager\ActiveID3 = 0
        ;    $\NuraThings\ModManager\ActiveID4 = 0
        ;    $\NuraThings\ModManager\ActiveID5 = 0
        endif


        if $\NuraThings\ModManager\Random_Mode == 1
            post $\NuraThings\ModManager\get_random_id_next_frame = 1
        endif

        if $Nura_Manager_First_Run
            if $\NuraThings\ModManager\Random_Mode == 2
                post $\NuraThings\ModManager\get_random_id_next_frame = 1
            endif
            post $Nura_Manager_First_Run = 0
        endif

    endif

    $swapped_in = 0
endif


if $mod_type_id == $\NuraThings\ModManager\ActiveTypeID

    if $once_per_frame  

        $\NuraThings\ModManager\AllModsActiveCount = $\NuraThings\ModManager\AllModsActiveCount+1

        $\NuraThings\ModManager\ModCount = $\NuraThings\ModManager\ModCount+1

        if $mod_id == -1 || $\NuraThings\ModManager\ResetIDs == 2
            $mod_id = $\NuraThings\ModManager\ModCount
        endif

        $once_per_frame = 0

        $\NuraThings\ModManager\ModID = $mod_id

        run = CustomShader\NuraThings\ModManager\HandleModIDs
    endif

    if $mod_id == $\NuraThings\ModManager\ActiveID || $mod_id == $\NuraThings\ModManager\ActiveID1 || $mod_id == $\NuraThings\ModManager\ActiveID2 || $mod_id == $\NuraThings\ModManager\ActiveID3 || $mod_id == $\NuraThings\ModManager\ActiveID2 || $mod_id == $\NuraThings\ModManager\ActiveID3 || $mod_id == $\NuraThings\ModManager\ActiveID4 || $mod_id == $\NuraThings\ModManager\ActiveID5
        $mod_enabled = 1

        if $mod_id == $\NuraThings\ModManager\ActiveID
            $id_slot = 0
        else if $mod_id == $\NuraThings\ModManager\ActiveID1
            $id_slot = 1
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID2
        ;    $id_slot = 2
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID3
        ;    $id_slot = 3
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID4
        ;    $id_slot = 4
        ;else if $mod_id == $\NuraThings\ModManager\ActiveID5
        ;    $id_slot = 5
        endif


	Resource\NuraThings\ModManager\ModPath = ref ResourceModPath unless_null
	Resource\NuraThings\ModManager\ModToggles = ref ResourceModToggles unless_null
	Resource\NuraThings\ModManager\ModAuthor = ref ResourceModAuthor unless_null
	Resource\NuraThings\ModManager\ModName = ref ResourceModName unless_null

        
    else
        $mod_enabled = 0
        
    endif
endif


if $once_per_frame  
    $\NuraThings\ModManager\AllModsActiveCount = $\NuraThings\ModManager\AllModsActiveCount+1
    $once_per_frame = 0
endif



