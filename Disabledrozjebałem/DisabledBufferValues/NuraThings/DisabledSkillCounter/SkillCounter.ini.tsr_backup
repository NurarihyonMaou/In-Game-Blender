$size_x = $icon_size_x
$size_y = $icon_size_y
$numbers_color = 1

[CommandListSetToSlot]
if $SkillActivationTime > 0

    if $active_unit_id == $slot_1_unit_id
        $slot_1_skill_timestamp = $SkillActivationTime
        $slot_1_hold = $active_unit_hold

    else if $active_unit_id == $slot_2_unit_id
        $slot_2_skill_timestamp = $SkillActivationTime
        $slot_2_hold = $active_unit_hold

    else if $active_unit_id == $slot_3_unit_id
        $slot_3_skill_timestamp = $SkillActivationTime
        $slot_3_hold = $active_unit_hold

    else if $active_unit_id == $slot_4_unit_id
        $slot_4_skill_timestamp = $SkillActivationTime
        $slot_4_hold = $active_unit_hold
    endif

endif

if $BurstActivationTime > 0

    if $active_unit_id == $slot_1_unit_id
        $slot_1_burst_timestamp = $BurstActivationTime

    else if $active_unit_id == $slot_2_unit_id
        $slot_2_burst_timestamp = $BurstActivationTime

    else if $active_unit_id == $slot_3_unit_id
        $slot_3_burst_timestamp = $BurstActivationTime

    else if $active_unit_id == $slot_4_unit_id
        $slot_4_burst_timestamp = $BurstActivationTime
    endif
    
    $BurstActivationTime = 0
endif

[CommandListReset]
$slot_1_unit_id = -1
$slot_1_burst_cd = -1
$slot_1_skill_cd = -1
$slot_1_burst_duration = -1
$slot_1_skill_duration = -1
$slot_1_skill_timestamp = 0
$slot_1_burst_timestamp = 0
$slot_1_skill_cd_left = 0
$slot_1_burst_cd_left = 0
$slot_1_skill_duration_left = 0
$slot_1_burst_duration_left = 0
$slot_1_skill_hold_cd = -1
$slot_1_skill_hold_duration = -1

$slot_2_unit_id = -1
$slot_2_burst_cd = -1
$slot_2_skill_cd = -1
$slot_2_burst_duration = -1
$slot_2_skill_duration = -1
$slot_2_skill_timestamp = 0
$slot_2_burst_timestamp = 0
$slot_2_skill_cd_left = 0
$slot_2_burst_cd_left = 0
$slot_2_skill_duration_left = 0
$slot_2_burst_duration_left = 0
$slot_2_skill_hold_cd = -1
$slot_2_skill_hold_duration = -1

$slot_3_unit_id = -1
$slot_3_burst_cd = -1
$slot_3_skill_cd = -1
$slot_3_burst_duration = -1
$slot_3_skill_duration = -1
$slot_3_skill_timestamp = 0
$slot_3_burst_timestamp = 0
$slot_3_skill_cd_left = 0
$slot_3_burst_cd_left = 0
$slot_3_skill_duration_left = 0
$slot_3_burst_duration_left = 0
$slot_3_skill_hold_cd = -1
$slot_3_skill_hold_duration = -1

$slot_4_unit_id = -1
$slot_4_burst_cd = -1
$slot_4_skill_cd = -1
$slot_4_burst_duration = -1
$slot_4_skill_duration = -1
$slot_4_skill_timestamp = 0
$slot_4_burst_timestamp = 0
$slot_4_skill_cd_left = 0
$slot_4_burst_cd_left = 0
$slot_4_skill_duration_left = 0
$slot_4_burst_duration_left = 0
$slot_4_skill_hold_cd = -1
$slot_4_skill_hold_duration = -1

$active_unit_skill_cd_left = 0
$active_unit_burst_cd_left = 0

run = CommandListSetInfo

[CommandListSetInfo]
if $active_unit_id != $slot_1_unit_id && $active_unit_id != $slot_2_unit_id && $active_unit_id != $slot_3_unit_id && $active_unit_id != $slot_4_unit_id
    if $slot_1_unit_id == -1
        $slot_1_unit_id = $active_unit_id
        $slot_1_burst_cd = $active_unit_burst_cd
        $slot_1_skill_hold_cd = $active_unit_skill_hold_cd
        $slot_1_skill_cd = $active_unit_skill_cd
        $slot_1_burst_duration = $active_unit_burst_duration
        $slot_1_skill_duration = $active_unit_skill_duration
        $slot_1_skill_hold_duration = $active_unit_skill_hold_duration

    else if $slot_2_unit_id == -1
        $slot_2_unit_id = $active_unit_id
        $slot_2_burst_cd = $active_unit_burst_cd
        $slot_2_skill_hold_cd = $active_unit_skill_hold_cd
        $slot_2_skill_cd = $active_unit_skill_cd
        $slot_2_burst_duration = $active_unit_burst_duration
        $slot_2_skill_duration = $active_unit_skill_duration
        $slot_2_skill_hold_duration = $active_unit_skill_hold_duration

    else if $slot_3_unit_id == -1
        $slot_3_unit_id = $active_unit_id
        $slot_3_burst_cd = $active_unit_burst_cd
        $slot_3_skill_hold_cd = $active_unit_skill_hold_cd        
        $slot_3_skill_cd = $active_unit_skill_cd
        $slot_3_burst_duration = $active_unit_burst_duration
        $slot_3_skill_duration = $active_unit_skill_duration
        $slot_3_skill_hold_duration = $active_unit_skill_hold_duration

    else if $slot_4_unit_id == -1
        $slot_4_unit_id = $active_unit_id
        $slot_4_burst_cd = $active_unit_burst_cd
        $slot_4_skill_hold_cd = $active_unit_skill_hold_cd
        $slot_4_skill_cd = $active_unit_skill_cd
        $slot_4_burst_duration = $active_unit_burst_duration
        $slot_4_skill_duration = $active_unit_skill_duration
        $slot_4_skill_hold_duration = $active_unit_skill_hold_duration
    else
        run = CommandListReset
    endif
endif


[CommandListSetBurstTime]
$BurstActivationTime = time+0.25
run = CommandListSetToSlot

[CommandListSetSkillTime]
$SkillActivationTime = time+0.25
run = CommandListSetToSlot



[CustomShaderSliderMenu]
local $x87 = x87
local $y87 = y87
local $z87 = z87
local $w87 = w87

x87 = $size_x
y87 = $size_y
z87 = $offset_x
w87 = $offset_y

hs = null
ds = null
gs = null
cs = null
run = BuiltInCommandListUnbindAllRenderTargets

vs = ../Shaders/UIElement.hlsl
ps = ../Shaders/UIElement.hlsl
blend = ADD SRC_ALPHA INV_SRC_ALPHA
cull = none
topology = triangle_strip
o0 = set_viewport bb
Draw = 4,0

x87 = $x87
y87 = $y87
z87 = $z87
w87 = $w87


[CommandListTimer]
$size_x = (128/res_width)/2
$size_y = (128/res_height)/2

if $slot_1_skill_timestamp > 0
    if $slot_1_hold == 1 && $slot_1_skill_hold_cd != -1
        $slot_1_skill_cd_left = $slot_1_skill_hold_cd+0.1 - (time - $slot_1_skill_timestamp) // 1
        $slot_1_skill_duration_left = $slot_1_skill_hold_duration+0.24 - (time - $slot_1_skill_timestamp) // 1  
    else
        $slot_1_skill_cd_left = $slot_1_skill_cd - (time - $slot_1_skill_timestamp) // 1
        $slot_1_skill_duration_left = $slot_1_skill_duration - (time - $slot_1_skill_timestamp) // 1  
    endif

    $offset_x = $slot_1_skill_icon_x
    $offset_y = $slot_1_skill_icon_y

    $SkillOrBurst = 0 
    $current_unit_id = $slot_1_unit_id

    run = CommandList\NuraThings\SkillCounter\Resources\GibResource
    ps-t100 = ResourceIcon
    run = CustomShaderSliderMenu 

    $offset_x = $slot_1_skill_icon_x-0.01125
    $offset_y = $slot_1_skill_icon_y
    $number = $slot_1_skill_duration_left

    if $slot_1_skill_duration_left <= 0 && $slot_1_skill_cd_left > 0
        $number = $slot_1_skill_cd_left
        $numbers_color = 0
    endif
    
    run = CommandListCalculateNumbers
    run = CommandListSetCurrentCD

    if $slot_1_skill_cd_left <= 0 && $slot_1_skill_duration_left <= 0
        $slot_1_skill_timestamp = 0
    endif
endif


if $slot_1_burst_timestamp > 0
    $slot_1_burst_cd_left = $slot_1_burst_cd - (time - $slot_1_burst_timestamp) // 1  
    $slot_1_burst_duration_left = $slot_1_burst_duration - (time - $slot_1_burst_timestamp) // 1 
    

    $offset_x = $slot_1_burst_icon_x
    $offset_y = $slot_1_burst_icon_y

    $SkillOrBurst = 1
    $current_unit_id = $slot_1_unit_id

    run = CommandList\NuraThings\SkillCounter\Resources\GibResource
    ps-t100 = ResourceIcon
    run = CustomShaderSliderMenu 
    
    $offset_x = $slot_1_burst_icon_x-0.01125
    $offset_y = $slot_1_burst_icon_y
    $number = $slot_1_burst_duration_left

    if $slot_1_burst_duration_left <= 0 && $slot_1_burst_cd_left > 0
        $number = $slot_1_burst_cd_left
        $numbers_color = 0
    endif

    run = CommandListCalculateNumbers
    run = CommandListSetCurrentCD

    if $slot_1_burst_cd_left <= 0 && $slot_1_burst_duration_left <= 0
        $slot_1_burst_timestamp = 0
    endif
endif



