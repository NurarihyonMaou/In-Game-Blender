            $snake_x = 0.01

        else if $snake_y <= 0
            $snake_y = 0.99

        else if $snake_y >= 1
            $snake_y = 0.01
        endif
    else
        if $snake_x <= 0 || $snake_x >= 1 || $snake_y <= 0 || $snake_y >= 1
            run = CommandListReset
        endif
