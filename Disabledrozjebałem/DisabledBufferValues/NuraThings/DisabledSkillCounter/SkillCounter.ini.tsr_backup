; MARK: Drag Icons
if $drag
    ; Skill
    if (cursor_x >= $slot_1_skill_icon_x && cursor_x <= $slot_1_skill_icon_x+$icon_size_x) && (cursor_y >= $slot_1_skill_icon_y && cursor_y <= $slot_1_skill_icon_y+$icon_size_y)
        $slot_1_skill_icon_x = cursor_x-($icon_size_x/2)
        $slot_1_skill_icon_y = cursor_y-($icon_size_y/2)
    
    else if (cursor_x >= $slot_2_skill_icon_x && cursor_x <= $slot_2_skill_icon_x+$icon_size_x) && (cursor_y >= $slot_2_skill_icon_y && cursor_y <= $slot_2_skill_icon_y+$icon_size_y)
        $slot_2_skill_icon_x = cursor_x-($icon_size_x/2)
        $slot_2_skill_icon_y = cursor_y-($icon_size_y/2)
    
    else if (cursor_x >= $slot_3_skill_icon_x && cursor_x <= $slot_3_skill_icon_x+$icon_size_x) && (cursor_y >= $slot_3_skill_icon_y && cursor_y <= $slot_3_skill_icon_y+$icon_size_y)
        $slot_3_skill_icon_x = cursor_x-($icon_size_x/2)
        $slot_3_skill_icon_y = cursor_y-($icon_size_y/2)
    
    else if (cursor_x >= $slot_4_skill_icon_x && cursor_x <= $slot_4_skill_icon_x+$icon_size_x) && (cursor_y >= $slot_4_skill_icon_y && cursor_y <= $slot_4_skill_icon_y+$icon_size_y)
        $slot_4_skill_icon_x = cursor_x-($icon_size_x/2)
        $slot_4_skill_icon_y = cursor_y-($icon_size_y/2)

    ; Burst

    else if (cursor_x >= $slot_1_burst_icon_x && cursor_x <= $slot_1_burst_icon_x+$icon_size_x) && (cursor_y >= $slot_1_burst_icon_y && cursor_y <= $slot_1_burst_icon_y+$icon_size_y)
        $slot_1_burst_icon_x = cursor_x-($icon_size_x/2)
        $slot_1_burst_icon_y = cursor_y-($icon_size_y/2)
    
    else if (cursor_x >= $slot_2_burst_icon_x && cursor_x <= $slot_2_burst_icon_x+$icon_size_x) && (cursor_y >= $slot_2_burst_icon_y && cursor_y <= $slot_2_burst_icon_y+$icon_size_y)
        $slot_2_burst_icon_x = cursor_x-($icon_size_x/2)
        $slot_2_burst_icon_y = cursor_y-($icon_size_y/2)
    
    else if (cursor_x >= $slot_3_burst_icon_x && cursor_x <= $slot_3_burst_icon_x+$icon_size_x) && (cursor_y >= $slot_3_burst_icon_y && cursor_y <= $slot_3_burst_icon_y+$icon_size_y)
        $slot_3_burst_icon_x = cursor_x-($icon_size_x/2)
        $slot_3_burst_icon_y = cursor_y-($icon_size_y/2)
    
    else if (cursor_x >= $slot_4_burst_icon_x && cursor_x <= $slot_4_burst_icon_x+$icon_size_x) && (cursor_y >= $slot_4_burst_icon_y && cursor_y <= $slot_4_burst_icon_y+$icon_size_y)
        $slot_4_burst_icon_x = cursor_x-($icon_size_x/2)
        $slot_4_burst_icon_y = cursor_y-($icon_size_y/2)

    endif
endif

