    endif

    if $num0 == 8
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber8
        run = CustomShaderSliderMenu
    endif

    if $num0 == 9
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber9
        run = CustomShaderSliderMenu
    endif


    $offset_x = $offset_x+0.013
    ;z87+$gap


    if $num1 == 0
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber0
        run = CustomShaderSliderMenu
    endif

    if $num1 == 1
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber1
        run = CustomShaderSliderMenu
    endif

    if $num1 == 2
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber2
        run = CustomShaderSliderMenu
    endif

    if $num1 == 3
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber3
        run = CustomShaderSliderMenu
    endif

    if $num1 == 4
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber4
        run = CustomShaderSliderMenu
    endif

    if $num1 == 5
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber5
        run = CustomShaderSliderMenu
    endif

    if $num1 == 6
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber6
        run = CustomShaderSliderMenu
    endif

    if $num1 == 7
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber7
        run = CustomShaderSliderMenu
    endif

    if $num1 == 8
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber8
        run = CustomShaderSliderMenu
    endif

    if $num1 == 9
        ps-t100 = Resource\NuraThings\Numbers\BlackNumber9
        run = CustomShaderSliderMenu
    endif

; MARK: White Numbers

else

    if $num0 == 0
        ps-t100 = Resource\NuraThings\Numbers\Number0
        run = CustomShaderSliderMenu
    endif

    if $num0 == 1
        ps-t100 = Resource\NuraThings\Numbers\Number1
        run = CustomShaderSliderMenu
    endif

    if $num0 == 2
        ps-t100 = Resource\NuraThings\Numbers\Number2
        run = CustomShaderSliderMenu
    endif

    if $num0 == 3
        ps-t100 = Resource\NuraThings\Numbers\Number3
