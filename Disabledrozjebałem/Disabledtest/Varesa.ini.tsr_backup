; Varesa

; Constants -------------------------

[Constants]
global $active = 0
global $creditinfo = 0
global persist $skin
global persist $face
global persist $abs
global persist $color
global persist $recolor


[KeySwapAbs]
condition = $active == 1
key = no_ctrl no_shift alt N
type = cycle
$abs = 0,1

[KeySwapSkin]
key = no_ctrl no_shift alt H
condition = $active == 1
type = cycle
$color = 0,2,4
$face= 0,1,2

[KeySwapColor]
key = no_ctrl no_shift alt Y
condition = $active == 1
type = cycle
$recolor = 0, 6, 12, 18

[Present]
post $active = 0
run = CommandListCreditInfo
post $skin = $recolor + $color + $abs


; Overrides -------------------------

[TextureOverrideVaresaPosition]
hash = 9784dbe3
vb0 = ResourceVaresaPosition
$activeForMenu = 1
$active = 1

[TextureOverrideVaresaBlend]
hash = ef26783e
vb1 = ResourceVaresaBlend
handling = skip
draw = 29342,0 

[TextureOverrideVaresaTexcoord]
hash = 0fa7f23f
vb1 = ResourceVaresaTexcoord

[TextureOverrideVaresaVertexLimitRaise]
hash = 8872531c
; override_vertex_count = 29342
; override_byte_stride = 84

[TextureOverrideVaresaIB]
hash = 488fceb4
handling = skip
drawindexed = auto

[TextureOverrideVaresaHead]
hash = 488fceb4
match_first_index = 0
ib = ResourceVaresaHeadIB
ps-t0 = ResourceVaresaHeadNormalMap
run = CommandListVaresaRecolor
ps-t2 = ResourceVaresaHeadLightMap
run = CommandList\global\ORFix\ORFix

[TextureOverrideVaresaBody]
hash = 488fceb4
match_first_index = 40554
ib = ResourceVaresaBodyIB
ps-t0 = ResourceVaresaBodyNormalMap
run = CommandListVaresaSkin
ps-t2 = ResourceVaresaBodyLightMap
run = CommandList\global\ORFix\ORFix

[TextureOverrideVaresaFaceHeadDiffuse]
hash = 9a534567
if $face == 0 
	ps-t0 = ResourceVaresaFaceHeadDiffuse
else if $face == 1
	ps-t0 = ResourceVaresaFaceHeadDiffuseDark
else if $face == 2
	ps-t0 = ResourceVaresaFaceHeadDiffuseDark2
endif

[TextureOverrideVaresaNatlanFXHeadShadow]
hash = 47590010
this = ResourceVaresaNatlanFXHeadShadow



; CommandList -----------------------

[CommandListCreditInfo]
if $creditinfo == 0 && $active == 1
    pre Resource\ShaderFixes\help.ini\Notification = ResourceCreditInfo
    pre run = CustomShader\ShaderFixes\help.ini\FormatText
    pre $\ShaderFixes\help.ini\notification_timeout = time + 5.0
    $creditinfo = 1
endif

[CommandListVaresaSkin]
if $skin == 0
	ps-t1 = ResourceVaresaBodyDiffuse
else if $skin == 1
	ps-t1 = ResourceVaresaBodyDiffuseAbs
else if $skin == 2
	ps-t1 = ResourceVaresaBodyDiffuseDark
else if $skin == 3
	ps-t1 = ResourceVaresaBodyDiffuseDarkAbs
else if $skin == 4
	ps-t1 = ResourceVaresaBodyDiffuseDark2
else if $skin == 5
	ps-t1 = ResourceVaresaBodyDiffuseDark2Abs
else if $skin == 6
	ps-t1 = ResourceVaresaBodyDiffuseRecolor
else if $skin == 7
	ps-t1 = ResourceVaresaBodyDiffuseRecolorAbs
else if $skin == 8
	ps-t1 = ResourceVaresaBodyDiffuseDarkRecolor
else if $skin == 9
	ps-t1 = ResourceVaresaBodyDiffuseDarkRecolorAbs
else if $skin == 10
	ps-t1 = ResourceVaresaBodyDiffuseDark2Recolor
else if $skin == 11
	ps-t1 = ResourceVaresaBodyDiffuseDark2RecolorAbs
else if $skin == 12
	ps-t1 = ResourceVaresaBodyDiffuseRecolor2
else if $skin == 13
	ps-t1 = ResourceVaresaBodyDiffuseRecolor2Abs
else if $skin == 14
	ps-t1 = ResourceVaresaBodyDiffuseDarkRecolor2
else if $skin == 15
	ps-t1 = ResourceVaresaBodyDiffuseDarkRecolor2Abs
else if $skin == 16
	ps-t1 = ResourceVaresaBodyDiffuseDark2Recolor2
else if $skin == 17
	ps-t1 = ResourceVaresaBodyDiffuseDark2Recolor2Abs
else if $skin == 18
	ps-t1 = ResourceVaresaBodyDiffuseRecolor3
else if $skin == 19
	ps-t1 = ResourceVaresaBodyDiffuseRecolor3Abs
else if $skin == 20
	ps-t1 = ResourceVaresaBodyDiffuseDarkRecolor3
else if $skin == 21
	ps-t1 = ResourceVaresaBodyDiffuseDarkRecolor3Abs
else if $skin == 22
	ps-t1 = ResourceVaresaBodyDiffuseDark2Recolor3
else if $skin == 23
	ps-t1 = ResourceVaresaBodyDiffuseDark2Recolor3Abs
endif

[CommandListVaresaRecolor]
if $recolor == 0
	ps-t1 = ResourceVaresaHeadDiffuse
else if $recolor == 6
	ps-t1 = ResourceVaresaHeadDiffuseRecolor
else if $recolor == 12
	ps-t1 = ResourceVaresaHeadDiffuseRecolor2
else if $recolor == 18
	ps-t1 = ResourceVaresaHeadDiffuseRecolor3
endif

[CommandListVaresaBarBase]
if $recolor == 0
	this = ResourceVaresaBarbase
else if $recolor == 6
	this = ResourceVaresaBarbase1
else if $recolor == 12
