; Navia

; Constants -------------------------

[Constants]
global $active = 0
global $creditinfo = 0

global persist $cat_ears = 1
global persist $boots = 2
global persist $thong = 1
global persist $top = 1
global persist $accs = 1
global persist $sweater = 1
global persist $body = 1


[Present]
post $active = 0
run = CommandListCreditInfo


[KeyCatEars]
condition = $active && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = L
type = cycle
$cat_ears = 0,1


[KeyBoots]
condition = $active && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = K
type = cycle
$boots = 0,1,2


[KeyThong]
condition = $active && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = P
type = cycle
$thong = 0,1


[KeyTop]
condition = $active && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = O
type = cycle
$top = 0,1


[KeyAccs]
condition = $active && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = I
type = cycle
$accs = 0,1


[KeySweater]
condition = $active && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = U
type = cycle
$sweater = 0,1


[KeyBody]
condition = $active && $mod_type_id == $\NuraThings\ModManager\ActiveTypeID && $mod_enabled == 1
key = H
type = cycle
$body = 1,2

; Overrides -------------------------


[TextureOverrideNaviaPosition]
hash = f4e09bd7
match_priority = 0
if $Mod_Enabled
    vb0 = ResourceNaviaPosition
    $activeForMenu = 1
    $active = 1
    
endif

[TextureOverrideNaviaBlend]
hash = bc0e2536
match_priority = 0
if $Mod_Enabled
    vb1 = ResourceNaviaBlend
    handling = skip
    draw = 184164,0
    
endif

[TextureOverrideNaviaTexcoord]
hash = 8a666020
match_priority = 0
if $Mod_Enabled
    vb1 = ResourceNaviaTexcoord
    
endif

[TextureOverrideNaviaVertexLimitRaise]
hash = 6b4e87d7
match_priority = 0
if $Mod_Enabled
    override_vertex_count = 184164
    override_byte_stride = 92
    
endif

[TextureOverrideNaviaIB]
hash = 7321d0b1
match_priority = 0
if $once_per_frame
    run = CommandListManageMod
    $once_per_frame = 0
endif

if $Mod_Enabled
    handling = skip
    
endif

[TextureOverrideNaviaHead]
hash = 7321d0b1
match_first_index = 0
if $once_per_frame
    run = CommandListManageMod
    $once_per_frame = 0
endif

if $Mod_Enabled
    ib = ResourceNaviaHeadIB
    ps-t0 = ResourceNaviaHeadNormalMap
    ps-t1 = ResourceNaviaHeadDiffuse
    ps-t2 = ResourceNaviaHeadLightMap
    run = CommandList\global\ORFix\ORFix
    
    ; NaviaHead
    ; Cat Ears (6517)
    if $cat_ears
        drawindexed = 23838, 0, 0
    endif
    ; Regular Hair (5837)
    drawindexed = 21288, 23838, 0
    
endif

[TextureOverrideNaviaBody]
hash = 7321d0b1
match_first_index = 54342
if $once_per_frame
    run = CommandListManageMod
    $once_per_frame = 0
endif

if $Mod_Enabled
    ib = ResourceNaviaBodyIB
    ps-t0 = ResourceNaviaBodyNormalMap
    ps-t1 = ResourceNaviaBodyDiffuse
    ps-t2 = ResourceNaviaBodyLightMap
    run = CommandList\global\ORFix\ORFix
    
    ; NaviaBody Eyes (120)
    drawindexed = 468, 0, 0
    
endif

[TextureOverrideNaviaDress]
hash = 7321d0b1
match_first_index = 74844
if $once_per_frame
    run = CommandListManageMod
    $once_per_frame = 0
endif

if $Mod_Enabled
    ib = ResourceNaviaDressIB
    ps-t0 = ResourceNaviaBodyNormalMap
    
    $texture_id = 1
    
    if $use_og || $update_texture
        ps-t1 = ResourceNaviaBodyDiffuse
        if $update_texture
            
            if $update_frame == -1
                $update_frame = $\NuraThings\ColorPicker\frame+5
            else if $\NuraThings\ColorPicker\frame >= $update_frame || $force_update == 1
                
                if $\NuraThings\ColorPicker\color_changed || $force_update == 1
                    run = CommandListModifyTexture
                    $use_og = 0
                    $update_texture = 0
                    $update_frame = -1
                    $force_update = 0
                endif
            endif
            
            ps-t1 = ResourceVirtualDress
        endif
    else
        ps-t1 = ResourceVirtualDress
    endif
    
    ps-t2 = ResourceNaviaBodyLightMap
    run = CommandList\global\ORFix\ORFix
    
    ; NaviaDress
    ; VD Accs (8995)
    if $accs
        drawindexed = 41541, 770112, 0
    endif
    ; Navia  (46716)
    if $body == 1 && $boots != 1
        drawindexed = 259308, 60348, 0
    endif
    ; Navia Boots (34382)
    if $boots == 1
        drawindexed = 191148, 319656, 0
    endif
    ; Navia TH (46928)
    if $body == 2 && $boots != 1
        drawindexed = 259308, 510804, 0
    endif
    ; Boots (8418)
    if $boots == 1
        drawindexed = 42168, 0, 0
    endif
    ; Heels (4186)
    if $boots == 2
        drawindexed = 18180, 42168, 0
    endif
    ; VD Thong (8159)
    if $thong
        drawindexed = 36351, 811653, 0
    endif
    ; VD Top (4143)
    if $top
        drawindexed = 19164, 848004, 0
    endif
    ; VK Sweater (9763)
    if $sweater
        drawindexed = 47490, 867168, 0
    endif
    
endif

[TextureOverrideNaviaFaceHeadDiffuse]
hash = 5fbb9b27
match_priority = 0
if $Mod_Enabled
    this = ResourceNaviaFaceHeadDiffuse
    
    
    ; CommandList -----------------------
    
endif

[CommandListCreditInfo]
if $creditinfo == 0 && $active == 1
pre Resource\ShaderFixes\help.ini\Notification = ResourceCreditInfo
pre run = CustomShader\ShaderFixes\help.ini\FormatText
pre $\ShaderFixes\help.ini\notification_timeout = time + 5.0
$creditinfo = 1
endif

; Resources -------------------------



[ResourceNaviaBlend]
type = Buffer
stride = 32
filename = NaviaBlend.buf


[ResourceNaviaTexcoord]
type = Buffer
stride = 20
filename = NaviaTexcoord.buf


[ResourceNaviaHeadIB]
type = Buffer
format = DXGI_FORMAT_R32_UINT
filename = NaviaHead.ib


[ResourceNaviaBodyIB]
type = Buffer
format = DXGI_FORMAT_R32_UINT
filename = NaviaBody.ib


[ResourceNaviaDressIB]
type = Buffer
format = DXGI_FORMAT_R32_UINT
filename = NaviaDress.ib


[ResourceNaviaHeadNormalMap]
filename = NaviaHeadNormalMap.dds


[ResourceNaviaHeadDiffuse]
filename = NaviaHeadDiffuse.dds


[ResourceNaviaHeadLightMap]
filename = NaviaHeadLightMap.dds


[ResourceNaviaBodyNormalMap]
filename = NaviaBodyNormalMap.dds


[ResourceNaviaBodyDiffuse]
filename = NaviaBodyDiffuse.dds


[ResourceNaviaBodyLightMap]
filename = NaviaBodyLightMap.dds


[ResourceNaviaDressNormalMap]
filename = NaviaDressNormalMap.dds


[ResourceNaviaDressDiffuse]
filename = NaviaDressDiffuse.dds


[ResourceNaviaDressLightMap]
filename = NaviaDressLightMap.dds


[ResourceNaviaFaceHeadDiffuse]
filename = NaviaFaceHeadDiffuse.dds


[ResourceCreditInfo]
type = Buffer
data = "Created by Levi, more at Patreon.com/LeviMods"

; .ini generated by XXMI (XX-Model-Importer)
; If you have any issues or find any bugs, please open a ticket at https://github.com/leotorrez/XXMI-Tools/issues
