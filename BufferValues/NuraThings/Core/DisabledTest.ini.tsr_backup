[CustomShaderSliderMenu]
vs = Resources/UIElement.hlsl
ps = Resources/UIElement.hlsl
blend = ADD SRC_ALPHA INV_SRC_ALPHA
cull = none
topology = triangle_strip
o0 = set_viewport bb
Draw = 4,0



[ResourceBox]
filename = Resources/Box.dds