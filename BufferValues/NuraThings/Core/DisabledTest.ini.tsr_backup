[Constants]
global $boxes = 13
global $boxes_per_row = 5

global $current_hovered_box

global $current_box
global $current_row
global $current_column

global $box_width = 0.1
global $box_height = 0.1

global $box_start_x = 0.12
global $box_start_y = 0.12

global $box_offset_x = 0.025
global $box_offset_y = 0.025

global $toggle0
global $toggle1
global $toggle2
global $toggle3
global $toggle4

global $toggle5
global $toggle6
global $toggle7
global $toggle8
global $toggle9

global $toggle10
global $toggle11
global $toggle12

global $click

global $full_rows
global $boxes_in_last_row
global $row_offset

[Present]
run = CommandListBox0
run = CommandListBox1
run = CommandListBox2
run = CommandListBox3
run = CommandListBox4
run = CommandListBox5
run = CommandListBox6
run = CommandListBox7
run = CommandListBox8
run = CommandListBox9
run = CommandListBox10
run = CommandListBox11
run = CommandListBox12
run = CommandListBox13


; --- Cursor Click Handling ---
if $click

    run = CommandListDetectBox
    ; Toggle Box depending on Current Index
    if $current_hovered_box == 0
        $toggle0 = !$toggle0

    elif $current_hovered_box == 1
        $toggle1 = !$toggle1

    elif $current_hovered_box == 2
        $toggle2 = !$toggle2

    elif $current_hovered_box == 3
        $toggle3 = !$toggle3

    elif $current_hovered_box == 4
        $toggle4 = !$toggle4

    elif $current_hovered_box == 5
        $toggle5 = !$toggle5

    elif $current_hovered_box == 6
        $toggle6 = !$toggle6

    elif $current_hovered_box == 7
        $toggle7 = !$toggle7

    elif $current_hovered_box == 8
        $toggle8 = !$toggle8

    elif $current_hovered_box == 9
        $toggle9 = !$toggle9

    elif $current_hovered_box == 10
        $toggle10 = !$toggle10

    elif $current_hovered_box == 11
        $toggle11 = !$toggle11

    elif $current_hovered_box == 12
        $toggle12 = !$toggle12
    endif

    $click = 0
endif

$\NuraThings\Debug\x5 = $toggle2
$\NuraThings\Debug\y5 = $toggle4
$\NuraThings\Debug\z5 = $toggle8
$\NuraThings\Debug\w5 = $toggle12
$\NuraThings\Debug\w4 = $current_hovered_box

post $current_box = 0
post $current_row = 0

[KeyClick]
key = VK_LBUTTON
$click = 1

[CommandListDetectBox]
; --- Compute current row/column under cursor ---
local $hover_row
local $hover_col
local $hover_box

$hover_col = ((cursor_x - $box_start_x) // ($box_width + $box_offset_x))
$hover_row = ((cursor_y - $box_start_y) // ($box_height + $box_offset_y))

; --- Clamp to valid range ---
if $hover_col < 0
    $hover_col = 0
endif
if $hover_col >= $boxes_per_row
    $hover_col = $boxes_per_row - 1
endif

local $l_full_rows = $boxes // $boxes_per_row
local $l_boxes_in_last_row = $boxes % $boxes_per_row

; Adjust column for last row centering
if $hover_row == $l_full_rows && $l_boxes_in_last_row > 0
    local $l_offset = ($boxes_per_row - $l_boxes_in_last_row) // 2
    $hover_col = $hover_col - $l_offset
    if $hover_col < 0
        $hover_col = 0
    endif
endif

; Compute box index from row/column
$hover_box = $hover_row * $boxes_per_row + $hover_col

; Clamp to max boxes
if $hover_box >= $boxes
    $hover_box = $boxes - 1
endif

$current_hovered_box = $hover_box


[CommandListHandleCurrentBox]
if $current_box < $boxes
    $current_row = $current_box // $boxes_per_row
    $current_column = $current_box % $boxes_per_row

    local $l_full_rows
    local $l_boxes_in_last_row
    local $l_offset

    $l_full_rows = $boxes // $boxes_per_row
    $l_boxes_in_last_row = $boxes % $boxes_per_row
    if $current_row == $l_full_rows && $l_boxes_in_last_row > 0
        $l_offset = ($boxes_per_row - $l_boxes_in_last_row) // 2
        $current_column = $current_column + $l_offset
    endif

    $current_box = $current_box + 1
endif



[CommandListBox0]
x87 = $box_width
y87 = $box_height
z87 = $box_start_x + ($box_width * $current_column) + ($box_offset_x  * $current_column) 
w87 = $box_start_y + ($box_height * $current_row) + ( $box_offset_y * $current_row)

ps-t100 = ResourceBox
run = CustomShaderSliderMenu
run = CommandListHandleCurrentBox


