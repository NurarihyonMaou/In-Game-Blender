[Keytop]
condition = $active == 1
key = no_modifiers y
type = cycle
$top = 0,1,2,3,4,5
$creditinfo = 0

[Keybottom]
condition = $active == 1
key = no_modifiers h
type = cycle
$bottom = 0,1
$creditinfo = 0

[Keylegs]
condition = $active == 1
key = no_modifiers n
type = cycle
$legs = 0,1,2,3,4
$creditinfo = 0

[KeyShoes]
condition = $active == 1
key = alt n
key = 8
type = cycle
$shoes = 0,1
$creditinfo = 0

[Keyjacket]
condition = $active == 1
key = 6
type = cycle
$jacket = 0,1,2,3,4,5,6,7
$creditinfo = 0

[Keychoker]
condition = $active == 1
key = 7
type = cycle
$choker = 0,1
$creditinfo = 0

[Keynipples]
condition = $active == 1
key = u
key = alt y
type = cycle
$nipples = 0,1,2,3
$creditinfo = 0

[Keypussy]
condition = $active == 1
key = i
key = alt h
type = cycle
$pussy = 0,1,2,3
$creditinfo = 0

[Present]
post $active = 0
run = CommandListCreditInfo

