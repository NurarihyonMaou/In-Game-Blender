[CommandListUpdateAll]
$UpdateAll = 1


[CommandListCreditInfo]
if $creditinfo == 0 && $active == 1
pre Resource\ShaderFixes\help.ini\Notification = ResourceCreditInfo
pre run = CustomShader\ShaderFixes\help.ini\FormatText
pre $\ShaderFixes\help.ini\notification_timeout = time + 5.0
$creditinfo = 1
endif


[CommandListTextureShader]
local $x99 = x99
local $y99 = y99
local $x101 = x101
local $y101 = y101

local $z101 = z101
local $w101 = w101

local $x102 = x102
local $y102 = y102

if $\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x != (($off_x-$icon_size/2)*$icon_size) - (($off_x-$icon_size*2.4)/2)*(($icon_size*3.5)/2) - (256/res_width)/4
    $RGB_X_Offset = (($off_x-$icon_size/2)*$icon_size) - (($off_x-$icon_size*2.4)/2)*(($icon_size*3.5)/2) - (256/res_width)/4
    $\Virgin_Destroyer_Navia_Texture_Edit_Menu\rgb_bar_x = $RGB_X_Offset
endif

y99 = $RGB_Slider_Type

x101 = $wheel_x
y101 = $wheel_y

z101 = $wheel_x1
w101 = $wheel_y1

x102 = $wheel_x2
y102 = $wheel_y2

if $UpdateAll


        ResourceLocalVirtualDress = ResourceNaviaDressDiffuse
        ResourceLocalVirtualHead = ResourceNaviaHeadDiffuse

        x99 = 0

        cs-t50 = copy ResourceNaviaDressDiffuse

        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_1 = 2048
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_2 = 1024
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\update_color = 1

        run = CommandList\Virgin_Destroyer_Navia_Texture_Edit_Menu\Draw
        run = CustomShader\Virgin_Destroyer_Navia_Texture_Edit_Menu\RunShader
        ResourceLocalVirtualDress = copy Resource\Virgin_Destroyer_Navia_Texture_Edit_Menu\Virtual3

        x99 = 1

        cs-t50 = copy ResourceNaviaHeadDiffuse
        cs-t51 = copy ResourceNaviaHairMask
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_1 = 2048
        $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_2 = 1024
	    $\Virgin_Destroyer_Navia_Texture_Edit_Menu\update_color = 1

        run = CommandList\Virgin_Destroyer_Navia_Texture_Edit_Menu\Draw
        run = CustomShader\Virgin_Destroyer_Navia_Texture_Edit_Menu\RunShader
        ResourceLocalVirtualHead = copy Resource\Virgin_Destroyer_Navia_Texture_Edit_Menu\Virtual2

        $UpdateAll = 0
else

        x99 = $RGB_Toggle

        run = CommandList\Virgin_Destroyer_Navia_Texture_Edit_Menu\Draw

        if $RGB_Toggle == 0
            cs-t50 = copy ResourceNaviaDressDiffuse

            $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_1 = 2048
            $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_2 = 1024

            run = CustomShader\Virgin_Destroyer_Navia_Texture_Edit_Menu\RunShader

            if $\Virgin_Destroyer_Navia_Texture_Edit_Menu\updated == 1
                ResourceLocalVirtualDress = copy Resource\Virgin_Destroyer_Navia_Texture_Edit_Menu\Virtual3
            endif

        else
            cs-t50 = copy ResourceNaviaHeadDiffuse
            cs-t51 = copy ResourceNaviaHairMask

            $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_1 = 2048
            $\Virgin_Destroyer_Navia_Texture_Edit_Menu\_2 = 1024

            run = CustomShader\Virgin_Destroyer_Navia_Texture_Edit_Menu\RunShader

            if $\Virgin_Destroyer_Navia_Texture_Edit_Menu\updated == 1
                ResourceLocalVirtualHead = copy Resource\Virgin_Destroyer_Navia_Texture_Edit_Menu\Virtual2
            endif

        endif

endif

x99 = $x99
y99 = $y99

x101 = $x101
y101 = $y101

z101 = $z101
w101 = $w101

x102 = $x102
y102 = $y102

